# Copy to .env (ignored). Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
NIANBOX_API_TOKEN=
NIANBOX_PORT=8088
# Pin ghcr.io/takboo/nianbox@sha256:... for reproducible deployments.
NIANBOX_IMAGE=ghcr.io/takboo/nianbox:main
# Add the real HTTPS hostname without scheme or port.
NIANBOX_ALLOWED_HOSTS=localhost,127.0.0.1,nianbox.example.ts.net
